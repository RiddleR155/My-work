# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/leathertique-impex
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leathertique-impex
MONGO_URI=mongodb://127.0.0.1:27017/leathertique-impex

# Secret used to sign JWTs - replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the Express server listens on
PORT=5000

# development | production
NODE_ENV=development
